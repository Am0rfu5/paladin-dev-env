# =============================================================================
# Development Container for Paladin
# Optimized for development with all tools and debugging capabilities
# Note: Using Bookworm (Debian 12) for OpenSSL 3.x support required by cargo-public-api
# Note: Rust version must match `channel` in the repo-root rust-toolchain.toml,
#       otherwise rustup will download a second toolchain on first cargo run.
# =============================================================================
FROM rust:1.97.1-slim-bookworm

# Set working directory
WORKDIR /workspace

# Avoid warnings by switching to noninteractive
ENV DEBIAN_FRONTEND=noninteractive

# Configure apt and install packages
RUN apt-get update \
    && apt-get -y install --no-install-recommends \
    # Essential build tools
    build-essential \
    pkg-config \
    libssl-dev \
    g++ \
    cmake \
    # Development tools
    git \
    curl \
    wget \
    vim \
    nano \
    jq \
    # Debugging tools
    gdb \
    lldb \
    valgrind \
    strace \
    # Database clients
    sqlite3 \
    default-mysql-client \
    redis-tools \
    # Network tools
    net-tools \
    iputils-ping \
    dnsutils \
    netcat-openbsd \
    # Process tools
    htop \
    procps \
    lsof \
    # SSL/TLS tools
    ca-certificates \
    openssl \
    # Shell enhancements
    zsh \
    # Shell linting (drives `make lint-shell` + the shellcheck pre-commit hook)
    shellcheck \
    # Documentation
    man-db \
    bash-completion \
    # Clean up
    && apt-get autoremove -y \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI (gh) — required for triggering and monitoring CI workflows
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 LTS from NodeSource — provides node/npm/npx, required by the
# GSD workflow tooling (`npx @opengsd/gsd-core@latest`, engines: node >=22, npm >=10).
# Debian bookworm only ships Node 18, which is too old, so the vendor repo is used.
# The key is stored ASCII-armored as .asc (apt supports this natively) to avoid
# pulling gnupg into the image just to dearmor it.
# Keep this an apt install: GSD writes the absolute interpreter path (/usr/bin/node)
# into .claude/settings.local.json hook commands, so a version-manager install
# (nvm/fnm, under $HOME) would break those hooks on rebuild.
RUN curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    -o /usr/share/keyrings/nodesource.asc \
    && chmod go+r /usr/share/keyrings/nodesource.asc \
    && echo "deb [signed-by=/usr/share/keyrings/nodesource.asc] https://deb.nodesource.com/node_22.x nodistro main" \
    | tee /etc/apt/sources.list.d/nodesource.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

# Install the Snyk CLI (pinned) — drives `make snyk-code` / `make snyk-test` and the
# mandatory code scan in .github/instructions/snyk_rules.instructions.md.
# Installed via the npm global prefix (/usr) so the binary lands on /usr/bin/snyk,
# available to the non-root user without a per-user install. Node 22 is provisioned
# above, so this must stay after the NodeSource block.
# Auth: the CLI reads SNYK_TOKEN (and SNYK_API for a custom endpoint) — NOT
# SNYK_API_KEY. .devcontainer/snyk-env.sh maps SNYK_API_KEY -> SNYK_TOKEN so the
# stored secret keeps the project's name while the CLI still authenticates.
RUN npm install -g snyk@1.1306.4 \
    && snyk --version

# Install pipx + pre-commit (commit/push quality gates) system-wide so the tool
# is available to the non-root user without a per-user install.
ENV PIPX_HOME=/usr/local/pipx \
    PIPX_BIN_DIR=/usr/local/bin
RUN apt-get update \
    && apt-get install -y --no-install-recommends pipx \
    && PIPX_HOME=$PIPX_HOME PIPX_BIN_DIR=$PIPX_BIN_DIR pipx install pre-commit \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

# Switch back to dialog for any ad-hoc use of apt-get
ENV DEBIAN_FRONTEND=dialog

# Install Rust components
RUN rustup component add \
    rustfmt \
    clippy \
    rust-src \
    llvm-tools-preview

# Install essential Rust tools.
# `--locked` is mandatory: without it cargo re-resolves every transitive dep to
# the newest published version, which can pull in a crate whose MSRV exceeds the
# pinned toolchain above and break the image build (e.g. kstring 2.0.4 requiring
# rustc 1.96 while this image is on 1.95). `--locked` uses each tool's own
# published Cargo.lock, which is known-good for that tool's MSRV.
RUN cargo install --locked cargo-watch
RUN cargo install --locked cargo-edit
RUN cargo install --locked cargo-audit
RUN cargo install --locked cargo-expand
RUN cargo install --locked cargo-insta
RUN cargo install --locked cargo-public-api

# Install cargo-release (pinned) — drives `make release` (lockstep version bump,
# changelog finalize, tag, push). See docs/RELEASE_AUTOMATION.md.
RUN cargo install --locked --version 1.1.2 cargo-release

# Install security/license/SBOM tooling (pinned) — drives `make deny`,
# `make security`, and `make sbom`. See docs/SECURITY_SCANNING.md.
RUN cargo install --locked --version 0.19.8 cargo-deny
RUN cargo install --locked --version 0.5.9 cargo-cyclonedx

# Install sqlx-cli for database migrations
RUN cargo install --locked sqlx-cli --no-default-features --features sqlite,mysql

# Install cargo-nextest (optional, can fail without breaking the build)
RUN cargo install --locked cargo-nextest || echo "cargo-nextest installation failed, skipping"

# Optional CLI tools - uncomment to install:
# RUN cargo install bat exa ripgrep fd-find tokei hyperfine

# Create a non-root user
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME -s /bin/bash \
    && apt-get update \
    && apt-get install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists/*

# Set up cargo permissions for non-root user
RUN mkdir -p /usr/local/cargo/registry \
    && chown -R $USER_UID:$USER_GID /usr/local/cargo

# Set up workspace permissions
RUN mkdir -p /workspace \
    && chown -R $USER_UID:$USER_GID /workspace

# Switch to non-root user
USER $USERNAME

# Set up shell configuration for vscode user
RUN echo 'export PATH="$HOME/.cargo/bin:$PATH"' >> ~/.bashrc \
    && echo 'export RUST_BACKTRACE=1' >> ~/.bashrc \
    && echo 'alias ll="ls -la"' >> ~/.bashrc

# Set environment variables
ENV RUST_BACKTRACE=1
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH=/usr/local/cargo/bin:$PATH

# Configure git safe directory (for mounted volumes)
RUN git config --global --add safe.directory /workspace

# Set the default shell
SHELL ["/bin/bash", "-c"]

# Expose common ports
EXPOSE 8080 9090

# Default command
CMD ["/bin/bash"]
