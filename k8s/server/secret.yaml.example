# Secrets for paladin-server. Copy to secret.yaml, fill in real values, and DO NOT commit it.
#   kubectl apply -f k8s/server/secret.yaml
#
# Or create imperatively:
#   kubectl -n paladin create secret generic paladin-server-secrets \
#     --from-literal=openai-api-key=sk-... \
#     --from-literal=api-key-ci=sk-svc-ci-... \
#     --from-literal=api-key-app=sk-svc-app-...
apiVersion: v1
kind: Secret
metadata:
  name: paladin-server-secrets
  namespace: paladin
  labels:
    app: paladin-server
type: Opaque
stringData:
  openai-api-key: "REPLACE_ME" # provider key for agent execution
  api-key-ci: "REPLACE_ME" # X-API-Key for the admin (CI) caller
  api-key-app: "REPLACE_ME" # X-API-Key for the user (frontend) caller
